# ESP-IDF version pinned to THIS repo. Auto-activated by direnv on cd.
# One-time setup:  brew install direnv  +  eval "$(direnv hook zsh)" in ~/.zshrc
export TBD_IDF_DIR="$HOME/esp/esp-idf-v6.0.1"

if [ ! -f "$TBD_IDF_DIR/export.sh" ]; then
  echo "⚠️  Pinned IDF not found: $TBD_IDF_DIR" >&2
elif [ "${IDF_PATH:-}" = "$TBD_IDF_DIR" ]; then
  :  # already active — skip the (slow) re-source
else
  source "$TBD_IDF_DIR/export.sh" >/dev/null 2>&1 \
    && echo "🟢 ESP-IDF pinned: $TBD_IDF_DIR" \
    || echo "⚠️  Failed to activate $TBD_IDF_DIR (run: source $TBD_IDF_DIR/export.sh)" >&2
fi

# Footgun guard: has the gitignored sdkconfig drifted from tracked defaults?
if [ -f sdkconfig ] && [ sdkconfig.defaults -nt sdkconfig ]; then
  echo "⚠️  sdkconfig is older than sdkconfig.defaults — likely STALE."
  echo "    Fix: ./build.sh   (auto-regenerates)   or   rm sdkconfig && idf.py build"
fi
